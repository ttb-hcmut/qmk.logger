#!/usr/bin/unfold ~/u/utop
(* vi: ft=ocaml: *)
-require eio;;
-require eio_main;;
-require cstruct;;
-require ppx_cstruct;;
-mod_use "%/../lib_evdev.ml";;
module Evdev = Lib_evdev

let () =
  Eio_main.run @@ fun env ->
  Evdev.Input.with_devname (Eio.Stdenv.fs env) "event3" @@ fun dev ->
    while true do
      let (_, type_, code, _value) = Evdev.read dev in
      if type_ <> 1 then () else
      Eio.traceln "qmk.logger: got type '%d' code '%d' value '%d'" type_ code (Int32.to_int _value);
    done
