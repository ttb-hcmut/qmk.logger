#!/usr/bin/unfold ~/u/utop
(* vi: set ft=ocaml: *)
-require' [eio; eio_main; cstruct; ppx_cstruct];;
[@@@module "%/../lib_evdev.ml" [@prefixed? "lib_"]]
open Eio

let () =
  Eio_main.run @@ fun env ->
  Evdev.Input.with_open_in (Stdenv.fs env) "event3" @@ fun dev ->
  let from_dev = Buf_read.of_flow ~max_size:1_000_000 dev in
  Buf_read.(seq Evdev.Buf_read.input_event) from_dev |> Seq.iter (fun (_, type_, code, _value) ->
    if type_ <> 1 then () else
    traceln "qmk.logger: got type '%d' code '%d' value '%d'" type_ code (Int32.to_int _value);
  )
